#!/usr/bin/env bash

set -euo pipefail

RELEASE="libhegel-v0.44.0"
BASE_URL="https://github.com/hegeldev/hegel-rust/releases/download/${RELEASE}"
HEADER_SHA256="a324eca375a51f0b46b41db6017c6d4f000324c3a6d3ee2563a17a11df4a6944"
LIBRARY_SHA256="c2baf69815c3cb7ebbcc690f6d721e21056ce278651d26e9e8c5ba795e2ce48c"

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "Unsupported operating system: $(uname -s) (expected Linux)" >&2
  exit 1
fi

case "$(uname -m)" in
  x86_64|amd64) ;;
  *)
    echo "Unsupported architecture: $(uname -m) (expected amd64)" >&2
    exit 1
    ;;
esac

for command in curl sha256sum; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Required command not found: $command" >&2
    exit 1
  fi
done

SPIKE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DESTINATION="${SPIKE_DIR}/vendor/${RELEASE}"
mkdir -p "$DESTINATION"

temporary_file=""
cleanup() {
  if [[ -n "$temporary_file" ]]; then
    rm -f "$temporary_file"
  fi
}
trap cleanup EXIT

fetch() {
  local asset="$1"
  local expected_sha256="$2"
  local destination="${DESTINATION}/${asset}"

  if [[ -f "$destination" ]] && printf '%s  %s\n' "$expected_sha256" "$destination" | sha256sum --check --status; then
    echo "Already verified: $destination"
    return
  fi

  temporary_file="$(mktemp "${destination}.tmp.XXXXXX")"
  echo "Fetching ${BASE_URL}/${asset}"
  curl --fail --location --silent --show-error --output "$temporary_file" "${BASE_URL}/${asset}"

  if ! printf '%s  %s\n' "$expected_sha256" "$temporary_file" | sha256sum --check --status; then
    echo "SHA-256 verification failed for $asset" >&2
    exit 1
  fi

  mv "$temporary_file" "$destination"
  temporary_file=""
  echo "Verified: $destination"
}

fetch "hegel.h" "$HEADER_SHA256"
fetch "libhegel-linux-amd64.so" "$LIBRARY_SHA256"
